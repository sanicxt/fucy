		"@types/node": "^26.6.5",
		"@types/web-bluetooth": "^0.0.22",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"cn": "^0.5.0",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.7.1",
